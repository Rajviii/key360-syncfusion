    "fields": [
        {
            "key": "id",
            "label": "Track ID",
            "controlType": "number",
            "showInGrid": true,
            "showInForm": false,
            "frozen": true,
            "width": 90,
            "allowSorting": true
        },
        {
            "key": "name",
            "label": "Song Title",
            "controlType": "text",
            "placeholder": "e.g. Quantum Heart",
            "validation": {
                "required": true,
                "minLength": 2
            },
            "showInGrid": true,
            "showInForm": true,
            "allowSorting": true,
            "allowFiltering": true
        },
        {
            "key": "status",
            "label": "Chart Status",
            "controlType": "select",
            "options": [
                {
                    "label": "Peak #1",
                    "value": "Peak #1"
                },
                {
                    "label": "Top 10",
                    "value": "Top 10"
                },
                {
                    "label": "Rising",
                    "value": "Rising"
                },
                {
                    "label": "Platinum Certified",
                    "value": "Platinum Certified"
                }
            ],
            "showInGrid": true,
            "showInForm": true,
            "groupable": true
        },
        {
            "key": "manager",
            "label": "Producer",
            "controlType": "autocomplete",
            "placeholder": "Select Producer...",
            "showInGrid": true,
            "showInForm": true
        },
        {
            "key": "assignee",
            "label": "Artist",
            "controlType": "autocomplete",
            "showInGrid": true,
            "showInForm": true
        },
        {
            "key": "assigneeRole",
            "label": "Artist Role",
            "controlType": "text",
            "showInGrid": false,
            "showInForm": true
        },
        {
            "key": "department",
            "label": "Genre",
            "controlType": "select",
            "options": [
                {
                    "label": "Pop",
                    "value": "Pop"
                },
                {
                    "label": "Hip-Hop / Rap",
                    "value": "Hip-Hop / Rap"
                },
                {
                    "label": "R&B / Soul",
                    "value": "R&B / Soul"
                },
                {
                    "label": "Country",
                    "value": "Country"
                },
                {
                    "label": "Dance / Electronic",
                    "value": "Dance / Electronic"
                },
                {
                    "label": "Alternative / Rock",
                    "value": "Alternative / Rock"
                }
            ],
            "showInGrid": true,
            "showInForm": true,
            "groupable": true
        },
        {
            "key": "budget",
            "label": "Streams (M)",
            "controlType": "number",
            "showInGrid": true,
            "showInForm": true,
            "aggregate": "sum",
            "allowSorting": true
        },
        {
            "key": "activeTasks",
            "label": "Peak Rank",
            "controlType": "number",
            "showInGrid": true,
            "showInForm": true
        },
        {
            "key": "progress",
            "label": "Chart Score %",
            "controlType": "rating",
            "showInGrid": true,
            "showInForm": true,
            "aggregate": "average"
        },
        {
            "key": "startDate",
            "label": "Release Date",
            "controlType": "date",
            "showInGrid": true,
            "showInForm": true,
            "format": "yyyy-MM-dd"
        },
        {
            "key": "endDate",
            "label": "Peak Date",
            "controlType": "date",
            "showInGrid": true,
            "showInForm": true,
            "format": "yyyy-MM-dd"
        }
    ],
    "views": [
        {
            "id": "v-dashboard",
            "name": "Chart Dashboard",
            "type": "dashboard",
            "icon": "LayoutDashboard",
            "description": "Billboard Hot 100 2026 Executive Analytics",
            "widgets": [
                {
                    "id": "w-kpi-1",
                    "title": "Total Streams (Millions)",
                    "type": "kpi",
                    "span": 4
                },
                {
                    "id": "w-kpi-2",
                    "title": "Charted Tracks",
                    "type": "kpi",
                    "span": 4
                },
                {
                    "id": "w-kpi-3",
                    "title": "Average Chart Score %",
                    "type": "kpi",
                    "span": 4
                },
                {
                    "id": "w-chart-streams",
                    "title": "Streams by Genre",
                    "type": "chart",
                    "span": 6,
                    "chartConfig": {
                        "chartType": "Column",
                        "xField": "department",
                        "yField": "budget",
                        "title": "Streams by Genre"
                    }
                },
                {
                    "id": "w-chart-score",
                    "title": "Chart Score % by Genre",
                    "type": "chart",
                    "span": 6,
                    "chartConfig": {
                        "chartType": "Pie",
                        "xField": "department",
                        "yField": "progress",
                        "title": "Chart Score % by Genre"
                    }
                },
                {
                    "id": "w-grid-summary",
                    "title": "Top Ranked Songs",
                    "type": "grid",
                    "span": 12,
                    "limit": 5,
                    "gridConfig": {
                        "allowPaging": true,
                        "pageSize": 5
                    }
                }
            ]
        },
        {
            "id": "v-grid",
            "name": "Hot 100 Rankings",
            "type": "grid",
            "icon": "Table",
            "widgets": [
                {
                    "id": "w-main-grid",
                    "title": "All Track Rankings",
                    "type": "grid",
                    "gridConfig": {
                        "virtualScrolling": true,
                        "allowPaging": true,
                        "pageSize": 25,
                        "allowSorting": true,
                        "allowFiltering": true,
                        "allowGrouping": true,
                        "allowColumnChooser": true,
                        "allowExcelExport": true,
                        "allowPdfExport": true,
                        "editMode": "Dialog",
                        "frozenColumns": 1
                    }
                }
            ]
        },
        {
            "id": "v-gantt",
            "name": "Release Schedule",
            "type": "gantt",
            "icon": "GitBranch",
            "widgets": [
                {
                    "id": "w-gantt-main",
                    "title": "Single Campaign Timeline",
                    "type": "gantt",
                    "ganttConfig": {
                        "taskIdField": "id",
                        "taskNameField": "name",
                        "startDateField": "startDate",
                        "endDateField": "endDate",
                        "durationField": "duration",
                        "progressField": "progress",
                        "dependencyField": "predecessor",
                        "childField": "subtasks",
                        "wbsCodeField": "wbsId",
                        "assigneeField": "assignee",
                        "statusField": "status"
                    }
                }
            ]
        },
        {
            "id": "v-kanban",
            "name": "Chart Status Workflow",
            "type": "kanban",
            "icon": "Kanban",
            "widgets": [
                {
                    "id": "w-kanban-main",
                    "title": "Song Performance Status",
                    "type": "kanban",
                    "kanbanConfig": {
                        "keyField": "id",
                        "headerField": "name",
                        "contentField": "manager",
                        "categoryField": "status",
                        "columns": [
                            {
                                "key": "Rising",
                                "title": "Rising"
                            },
                            {
                                "key": "Top 10",
                                "title": "Top 10"
                            },
                            {
                                "key": "Peak #1",
                                "title": "Peak #1"
                            },
                            {
                                "key": "Platinum Certified",
                                "title": "Platinum Certified"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "id": "v-form",
            "name": "Add / Edit Track",
            "type": "form",
            "icon": "FilePlus",
            "widgets": [
                {
                    "id": "w-track-form",
                    "title": "Track Information",
                    "type": "form"
                }
            ]
        }
    ]
}
