    "fields": [
        {
            "key": "id",
            "label": "Team ID",
            "controlType": "number",
            "showInGrid": true,
            "showInForm": false,
            "frozen": true,
            "width": 90,
            "allowSorting": true
        },
        {
            "key": "name",
            "label": "Team",
            "controlType": "text",
            "placeholder": "e.g. Argentina",
            "validation": {
                "required": true,
                "minLength": 3
            },
            "showInGrid": true,
            "showInForm": true,
            "allowSorting": true,
            "allowFiltering": true
        },
        {
            "key": "status",
            "label": "Tournament Status",
            "controlType": "select",
            "options": [
                {
                    "label": "Qualified",
                    "value": "Qualified"
                },
                {
                    "label": "Playing",
                    "value": "Playing"
                },
                {
                    "label": "Knocked Out",
                    "value": "Knocked Out"
                },
                {
                    "label": "Champion",
                    "value": "Champion"
                }
            ],
            "showInGrid": true,
            "showInForm": true,
            "groupable": true
        },
        {
            "key": "manager",
            "label": "Coach",
            "controlType": "autocomplete",
            "placeholder": "Select Coach...",
            "showInGrid": true,
            "showInForm": true
        },
        {
            "key": "assignee",
            "label": "Captain",
            "controlType": "autocomplete",
            "showInGrid": true,
            "showInForm": true
        },
        {
            "key": "assigneeRole",
            "label": "Captain Role",
            "controlType": "text",
            "showInGrid": false,
            "showInForm": true
        },
        {
            "key": "department",
            "label": "Confederation",
            "controlType": "select",
            "options": [
                {
                    "label": "UEFA",
                    "value": "UEFA"
                },
                {
                    "label": "CONMEBOL",
                    "value": "CONMEBOL"
                },
                {
                    "label": "AFC",
                    "value": "AFC"
                },
                {
                    "label": "CAF",
                    "value": "CAF"
                },
                {
                    "label": "CONCACAF",
                    "value": "CONCACAF"
                },
                {
                    "label": "OFC",
                    "value": "OFC"
                }
            ],
            "showInGrid": true,
            "showInForm": true,
            "groupable": true
        },
        {
            "key": "budget",
            "label": "Goals Scored",
            "controlType": "number",
            "showInGrid": true,
            "showInForm": true,
            "aggregate": "sum",
            "allowSorting": true
        },
        {
            "key": "activeTasks",
            "label": "Matches Played",
            "controlType": "number",
            "showInGrid": true,
            "showInForm": true
        },
        {
            "key": "progress",
            "label": "Qualification %",
            "controlType": "rating",
            "showInGrid": true,
            "showInForm": true,
            "aggregate": "average"
        },
        {
            "key": "startDate",
            "label": "Tournament Start",
            "controlType": "date",
            "showInGrid": true,
            "showInForm": true,
            "format": "yyyy-MM-dd"
        },
        {
            "key": "endDate",
            "label": "Tournament End",
            "controlType": "date",
            "showInGrid": true,
            "showInForm": true,
            "format": "yyyy-MM-dd"
        }
    ],
    "views": [
        {
            "id": "v-dashboard",
            "name": "Tournament Dashboard",
            "type": "dashboard",
            "icon": "LayoutDashboard",
            "description": "FIFA World Cup 2026 Executive Dashboard",
            "widgets": [
                {
                    "id": "w-kpi-1",
                    "title": "Total Goals Scored",
                    "type": "kpi",
                    "span": 4
                },
                {
                    "id": "w-kpi-2",
                    "title": "Qualified Teams",
                    "type": "kpi",
                    "span": 4
                },
                {
                    "id": "w-kpi-3",
                    "title": "Average Qualification %",
                    "type": "kpi",
                    "span": 4
                },
                {
                    "id": "w-chart-goals",
                    "title": "Goals by Confederation",
                    "type": "chart",
                    "span": 6,
                    "chartConfig": {
                        "chartType": "Column",
                        "xField": "department",
                        "yField": "budget",
                        "title": "Goals by Confederation"
                    }
                },
                {
                    "id": "w-chart-progress",
                    "title": "Qualification %",
                    "type": "chart",
                    "span": 6,
                    "chartConfig": {
                        "chartType": "Pie",
                        "xField": "department",
                        "yField": "progress",
                        "title": "Qualification %"
                    }
                },
                {
                    "id": "w-grid-summary",
                    "title": "Top Ranked Teams",
                    "type": "grid",
                    "span": 12,
                    "limit": 5,
                    "gridConfig": {
                        "allowPaging": true,
                        "pageSize": 5
                    }
                }
            ]
        },
        {
            "id": "v-grid",
            "name": "Team Statistics",
            "type": "grid",
            "icon": "Table",
            "widgets": [
                {
                    "id": "w-main-grid",
                    "title": "All Teams",
                    "type": "grid",
                    "gridConfig": {
                        "virtualScrolling": true,
                        "allowPaging": true,
                        "pageSize": 25,
                        "allowSorting": true,
                        "allowFiltering": true,
                        "allowGrouping": true,
                        "allowColumnChooser": true,
                        "allowExcelExport": true,
                        "allowPdfExport": true,
                        "editMode": "Dialog",
                        "frozenColumns": 1
                    }
                }
            ]
        },
        {
            "id": "v-gantt",
            "name": "Tournament Schedule",
            "type": "gantt",
            "icon": "GitBranch",
            "widgets": [
                {
                    "id": "w-gantt-main",
                    "title": "Tournament Timeline",
                    "type": "gantt",
                    "ganttConfig": {
                        "taskIdField": "id",
                        "taskNameField": "name",
                        "startDateField": "startDate",
                        "endDateField": "endDate",
                        "durationField": "duration",
                        "progressField": "progress",
                        "dependencyField": "predecessor",
                        "childField": "subtasks",
                        "wbsCodeField": "wbsId",
                        "assigneeField": "assignee",
                        "statusField": "status"
                    }
                }
            ]
        },
        {
            "id": "v-kanban",
            "name": "Tournament Progress",
            "type": "kanban",
            "icon": "Kanban",
            "widgets": [
                {
                    "id": "w-kanban-main",
                    "title": "Tournament Status",
                    "type": "kanban",
                    "kanbanConfig": {
                        "keyField": "id",
                        "headerField": "name",
                        "contentField": "manager",
                        "categoryField": "status",
                        "columns": [
                            {
                                "key": "Qualified",
                                "title": "Qualified"
                            },
                            {
                                "key": "Playing",
                                "title": "Playing"
                            },
                            {
                                "key": "Knocked Out",
                                "title": "Knocked Out"
                            },
                            {
                                "key": "Champion",
                                "title": "Champion"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "id": "v-form",
            "name": "Add / Edit Team",
            "type": "form",
            "icon": "FilePlus",
            "widgets": [
                {
                    "id": "w-team-form",
                    "title": "Team Information",
                    "type": "form"
                }
            ]
        }
    ]
}